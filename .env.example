# ============================================
# ServiceWala Frontend - Environment Variables
# ============================================

# Backend API URL
# ---------------
# For local development:
REACT_APP_API_URL=http://localhost:5000/api

# For production deployment (Vercel):
# REACT_APP_API_URL=https://servicewala-backend-g4b8.onrender.com/api

# ============================================
# Setup Instructions:
# ============================================
# 1. Copy this file as .env in the root directory
# 2. Use localhost URL for development
# 3. Use production URL when deploying to Vercel
# 4. Add .env to .gitignore
# 5. Never commit the .env file to version control
# ============================================

# Note for Vercel Deployment:
# ---------------------------
# Add environment variables in Vercel Dashboard:
# 1. Go to Project Settings → Environment Variables
# 2. Add: REACT_APP_API_URL with production backend URL
# 3. Add: CI=false (to prevent build failures on warnings)
# ============================================
